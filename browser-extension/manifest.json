{
  "manifest_version": 3,
  "name": "Kuantra Terminal - TradingView Companion Sync",
  "version": "1.3.0",
  "description": "Sub-8ms symbol and timeframe synchronization bridge between TradingView and the Kuantra Terminal desktop app (integrations gateway, default port 8765).",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.tradingview.com/*",
    "http://127.0.0.1:*/*",
    "ws://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tradingview.com/chart/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kuantra TV Sync"
  }
}